<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Push at launch: installs the Kirora SDK's launch hook before any activity starts. -->
        <provider
            android:name="io.kirora.flutter.KiroraLaunchProvider"
            android:authorities="${applicationId}.kirora-flutter-launch"
            android:exported="false" />
    </application>
</manifest>
